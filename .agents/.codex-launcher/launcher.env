# Per-repository host launcher configuration. This file is intentionally not versioned.
# Keep it separate from Docker Compose's own .env semantics.
BRANCH=codex
IMAGE_NAME=smart-docs-framework
CONTAINER_NAME=smart-docs-framework-b4f960b9
GIT_USER_NAME=Marc\ Strapetz
GIT_USER_EMAIL=marc.strapetz@syntevo.com
# Append Codex-* commit metadata inside the container. Set to false to disable it.
CODEX_ENABLE_COMMIT_MSG_HOOK=true
